# Public build-time configuration for the app (EXPO_PUBLIC_* is inlined into
# the bundle — never put a secret here). Copy to .env.local.

# AI service (services/ai). Local: http://localhost:8000
EXPO_PUBLIC_AI_URL=http://localhost:8000
# Must match APP_KEY in services/ai/.env (abuse friction, not a secret).
EXPO_PUBLIC_APP_KEY=
# Platform worker (workers/platform). Local: http://localhost:8787
EXPO_PUBLIC_PLATFORM_URL=http://localhost:8787
# Supabase project URL and *publishable / anon* key. Leave empty for guest-only mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
