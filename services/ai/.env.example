# ComeMorocco AI — copy to .env and fill in.
# Only ANTHROPIC_API_KEY is required to run locally.

# ---- model ----------------------------------------------------------------
# Set ONE of the two keys below. The provider is chosen from whichever is set
# (Anthropic wins if both are). Force it with LLM_PROVIDER=anthropic|openrouter.
LLM_PROVIDER=

# Option A — Anthropic
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-4-6
UTILITY_MODEL=claude-haiku-4-5-20251001

# Option B — OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# off | low | medium | high | none
#   off  = ask the model not to think: fastest (~5 s vs 25-115 s on free
#          reasoning models) — recommended for the app
#   none = omit the parameter (for models that reject it; they may still think)
OPENROUTER_REASONING_EFFORT=off

# Second free OpenRouter model, tried when the first is rate-limited or down.
OPENROUTER_FALLBACK_MODEL=

# Option C — Cloudflare Workers AI, used as the last fallback.
# The free plan has a daily Neuron allowance; some models need Workers Paid.
# Always name the model explicitly — there is deliberately no default.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=

# Optional explicit chain (overrides the three settings above), tried in order:
#   LLM_CHAIN=openrouter:<model-a>:free,openrouter:<model-b>:free,workers_ai:@cf/<vendor>/<model>
# Measured 2026-09-30 through the full pipeline (docs/milestone-v0.2.md):
#   openrouter nemotron-3.5-lightning:free (reasoning off)  1-5 s first token, but can stall or degrade
#   workers_ai mistral-small-3.1-24b-instruct               ~1-2.5 s first token, clean in en/fr/es/ar
#   workers_ai llama-4-scout-17b-16e-instruct               ~1 s first token, shorter answers
# Recommended:
#   LLM_CHAIN=openrouter:nvidia/nemotron-3.5-lightning:free,workers_ai:@cf/mistralai/mistral-small-3.1-24b-instruct,workers_ai:@cf/meta/llama-4-scout-17b-16e-instruct
LLM_CHAIN=
# A provider that has not started answering within this many seconds is skipped (streaming);
# non-streaming calls get the second limit. Garbled starts are also skipped (router.py).
LLM_FIRST_TOKEN_TIMEOUT=10
LLM_PROVIDER_TIMEOUT=45

MAX_ANSWER_TOKENS=1400
TEMPERATURE=0.4

# Extra model calls per question. Left blank, they are ON for paid models and
# OFF for :free OpenRouter models, whose limit is 50 requests/day without
# purchased credits. Off = 1 request per question; on = up to 4.
MODEL_CLASSIFICATION_ENABLED=

# ---- service --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SITE_URL=https://comemorocco.com
CONTACT_URL=https://comemorocco.com/contact/
CORS_ORIGINS=http://localhost:8000,http://localhost:8081,https://comemorocco.com

# Shared with the WordPress plugin. Visible to browsers by design — it limits
# casual abuse, it is not a password. Leave empty in development.
WIDGET_KEY=
# Sent by the mobile app (X-App-Key). Same nature as WIDGET_KEY.
APP_KEY=
# Lets the service recognise signed-in app users from their Supabase access
# token. Set one: the legacy JWT secret, or the project URL (JWKS keys).
SUPABASE_JWT_SECRET=
SUPABASE_URL=
# Protects the moderation queue, analytics and reindex endpoints. Keep secret.
# While unset, every admin endpoint returns 503.
ADMIN_KEY=
# Shared with the plugin so it can signal content changes and the service can
# pull the content export. Generated on the plugin's settings page.
SYNC_SECRET=
WORDPRESS_URL=https://comemorocco.com

# ---- storage --------------------------------------------------------------
# SQLite by default. For production:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/comemorocco
DATABASE_URL=

# ---- behaviour ------------------------------------------------------------
# Leave false until a real weather/schedule integration exists. Turning it on
# without wiring a tool makes the assistant claim it checked things it did not.
LIVE_DATA_ENABLED=false
AFFILIATES_ENABLED=true
# Model review of each answer. Blank = on for paid models, off for :free ones.
# The free regex scan for invented experience and claimed bookings always runs.
QUALITY_CHECK_ENABLED=
SUPPORTED_LANGUAGES=en,fr

# ---- limits ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=60
# Signed-in app users get this many times the guest limits.
SIGNED_IN_RATE_MULTIPLIER=3
DAILY_TOKEN_BUDGET=4000000
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_TURNS=12

# ---- privacy --------------------------------------------------------------
CONVERSATION_RETENTION_DAYS=90
SESSION_TTL_DAYS=30
